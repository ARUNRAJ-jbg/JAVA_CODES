class grandpa{
    void display(){
        System.out.println("this the parent class");
    }
}
class father extends grandpa{
    void show(){
        System.out.println("this is the father class");
    }
}
class me extends grandpa{
    void show1(){
        System.out.println("this is the child class");
    }
}
public class Inheritance{
    public static void main(String[]args){
        me obj=new me();
        obj.show1();
        obj.display();
        father oaj=new father();
        oaj.show();
        obj.display();
    }

}
